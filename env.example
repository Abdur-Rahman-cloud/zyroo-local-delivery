# Copy this file to .env and adjust values as needed.
# Never commit the real .env file — add it to .gitignore.

# Base URL the service layer would call if wired to a real backend later.
VITE_API_BASE_URL=https://api.zyroo-local-delivery.mock

# Simulated network delay (ms) used by src/services/api.js
VITE_API_DELAY_MS=500
